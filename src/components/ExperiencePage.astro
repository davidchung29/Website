---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceSection from './ExperienceSection.astro';
import { workExperience, educationExperience, researchExperience, otherExperience } from '../data/displayData';
---

<BaseLayout title="David Chung - Experience" activePage="experience">
  <ExperienceSection title="WORK" id="work" entries={workExperience} />
  <ExperienceSection title="EDUCATION" id="education" entries={educationExperience} />
  <ExperienceSection title="RESEARCH" id="research" entries={researchExperience} />
  <ExperienceSection title="OTHER" id="other" entries={otherExperience} />
</BaseLayout>

<script is:inline src="/scripts/expandable-experience.js"></script>
