---
import type { workExperience, educationExperience, researchExperience, otherExperience } from '../data/displayData';

type Entry =
  | (typeof workExperience)[number]
  | (typeof educationExperience)[number]
  | (typeof researchExperience)[number]
  | (typeof otherExperience)[number];

interface Props {
  title: string;
  id: string;
  entries: readonly Entry[];
}

const { title, id, entries } = Astro.props;
---

<section class="section" id={id}>
  <h2 class="section-title">{title}</h2>
  <div class="experience-list">
    {entries.map((exp) => (
      'modal' in exp && exp.modal ? (
        <div
          class="experience-item modal-item"
          data-modal-org={exp.org}
          data-modal-role={exp.role}
          data-modal-date={exp.date}
          data-modal-links={JSON.stringify(exp.expandableLinks ?? [])}
          data-modal-views={JSON.stringify(('modalViews' in exp && exp.modalViews) || [])}
        >
          <img src={exp.logo} alt={exp.org} class:list={["experience-logo", exp.logoClass]} />
          <div class="experience-content">
            <div class="experience-header">
              <div class="experience-header-left">
                <div class="experience-org">{exp.org}</div>
              </div>
              <div class="experience-date">{exp.date}</div>
            </div>
            <div class="experience-footer">
              <div class="experience-desc">{exp.role}</div>
            </div>
          </div>
        </div>
      ) : 'expandableLinks' in exp && exp.expandableLinks ? (
        <div class="experience-item expandable-item">
          <img src={exp.logo} alt={exp.org} class:list={["experience-logo", exp.logoClass]} />
          <div class="experience-content">
            <div class="experience-header">
              <div class="experience-header-left">
                <div class="experience-org">{exp.org}</div>
              </div>
              <div class="experience-date">{exp.date}</div>
            </div>
            <div class="experience-footer">
              <div class="experience-desc">
                {exp.role}
                <div class="expandable-content">
                  <div class="expandable-links">
                    {exp.expandableLinks.map((link) => (
                      <a href={link.url} target="_blank" rel="noopener noreferrer" class="expandable-link">
                        <span class="expandable-link-text">{link.text}</span>
                        <svg class="expandable-link-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                          <polyline points="15 3 21 3 21 9"></polyline>
                          <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <div class="experience-item clickable-work" data-company-url={exp.companyUrl}>
          <img src={exp.logo} alt={exp.org} class:list={["experience-logo", exp.logoClass]} />
          <div class="experience-content">
            <div class="experience-header">
              <div class="experience-header-left">
                <div class="experience-org">{exp.org}</div>
              </div>
              <div class="experience-date">{exp.date}</div>
            </div>
            <div class="experience-footer">
              <div class="experience-desc">{exp.role}</div>
            </div>
          </div>
        </div>
      )
    ))}
  </div>
</section>
