---
export interface Props {
  title: string;
  activePage?: 'experience' | 'projects';
}

const { title, activePage } = Astro.props;

// Names what the phone layout leaves out, so the loading notice can be specific
// about what a desktop visit adds rather than nagging generically.
const desktopOnly = activePage === 'projects'
  ? 'project demos'
  : 'project demos, papers, and posts';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="stylesheet" href="/styles/main.css">
  <script is:inline>
    // Everything here runs before first paint, so navigating between pages
    // never flashes the wrong theme or loading screen.
    (function () {
      var html = document.documentElement;

      try {
        if (sessionStorage.getItem('hasLoaded')) {
          html.classList.add('skip-loading');
        }
      } catch (e) {
        // sessionStorage unavailable (private mode) — show the loading screen.
      }

      try {
        if (localStorage.getItem('theme') === 'dark') {
          html.setAttribute('data-theme', 'dark');
        }
      } catch (e) {
        // localStorage unavailable — fall back to the default palette.
      }
    })();
  </script>
</head>
<body class="loading">
  <!-- Loading Screen -->
  <div class="loading-screen" id="loadingScreen">
    <!-- Shown only on phones, where the modals drop their media panel -->
    <p class="loading-note">View on desktop for {desktopOnly}</p>
    <div class="loading-bar-container">
      <div class="loading-bar" id="loadingBar"></div>
    </div>
  </div>

  <div class="app-container">
    <div class="page" id="mainPage">
      <div class="header">
        <h1>David Chung</h1>
        <nav class="nav-buttons">
          <a href="/experience" class:list={["nav-button", { active: activePage === 'experience' }]}>experience</a>
          <a href="/projects" class:list={["nav-button", { active: activePage === 'projects' }]}>projects</a>
          <a href="/David-Chung.pdf" download="David-Chung.pdf" class="nav-button">resume</a>
        </nav>
      </div>

      <div class="main">
        <slot />
      </div>

      <div class="footer">
        <div class="social-links">
          <button class="social-link email-copy" id="emailCopy" data-email="dichung@andrew.cmu.edu" aria-label="Copy email address">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span class="email-copied" aria-hidden="true">Copied email</span>
          </button>
          <a href="https://github.com/davidchung29" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/david-chung-00b04a199/" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode">
            <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Floating Action Button -->
    <button class="fab" id="fab" aria-label="Toggle overlay">
      <svg class="fab-icon terminal-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="16" rx="2" ry="2"></rect>
        <line x1="6" y1="8" x2="6" y2="8"></line>
        <line x1="9" y1="8" x2="9" y2="8"></line>
        <line x1="12" y1="8" x2="12" y2="8"></line>
        <path d="M6 12h12"></path>
        <path d="M6 16h8"></path>
      </svg>
      <svg class="fab-icon x-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Liquid Overlay / Chat -->
    <div class="liquid-overlay" id="liquidOverlay">
      <div class="chat-terminal" id="chatTerminal">
        <div class="chat-terminal-header">
          <div class="chat-terminal-title">davidchung.io</div>
          <button class="chat-terminal-close" id="chatClose" aria-label="Close chat">×</button>
        </div>

        <div class="chat-terminal-content">
          <div class="chat-output" id="chatOutput"></div>

          <div class="chat-input-area">
            <div class="chat-input-container">
              <span class="chat-prompt">→</span>
              <input
                type="text"
                class="chat-input"
                id="chatInput"
                placeholder="Ask me anything..."
                autocomplete="off"
                autocapitalize="none"
                autocorrect="off"
                spellcheck="false"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bento-overlay" id="bentoOverlay" hidden>
    <div class="bento-modal" role="dialog" aria-modal="true" aria-labelledby="bentoTitle" tabindex="-1">
      <button class="bento-close" id="bentoClose" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="bento-grid">
        <section class="bento-panel bento-primary bento-panel--media">
          <div class="bento-media-viewport">
            <div class="bento-media-stack" id="bentoMedia"></div>
          </div>
          <div class="bento-controls" id="bentoControls">
            <button class="bento-arrow bento-arrow--prev" id="bentoPrev" type="button" aria-label="Previous project">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <div class="bento-pager" id="bentoPager" role="tablist" aria-label="Projects"></div>
            <button class="bento-arrow bento-arrow--next" id="bentoNext" type="button" aria-label="Next project">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        </section>
        <section class="bento-panel bento-secondary">
          <div class="bento-panel-inner">
            <div class="bento-head">
              <h2 class="bento-title" id="bentoTitle"></h2>
              <p class="bento-subtitle" id="bentoSubtitle"></p>
              <p class="bento-authors" id="bentoAuthors" hidden></p>
              <div class="bento-links" id="bentoLinks"></div>
            </div>
            <div class="bento-copy" id="bentoCopy"></div>
          </div>
        </section>
      </div>
    </div>
  </div>

  <script is:inline src="/scripts/loading.js"></script>
  <script is:inline src="/scripts/theme-toggle.js"></script>
  <script is:inline src="/scripts/email-copy.js"></script>
  <script is:inline src="/scripts/fab.js"></script>
  <script is:inline src="/scripts/chat.js"></script>
  <script is:inline src="/scripts/work-links.js"></script>
  <script is:inline src="/scripts/bento-modal.js"></script>
</body>
</html>
